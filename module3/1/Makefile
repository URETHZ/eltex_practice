# ============================================================
#  Makefile для проекта filecopy
# ============================================================

CC      := gcc
CFLAGS  := -Wall -Wextra -O2 -std=c11 -D_GNU_SOURCE
TARGET  := filecopy
SRC     := filecopy.c
OBJ     := $(SRC:.c=.o)

# ------------------------------------------------------------
#  Цели по умолчанию
# ------------------------------------------------------------
.PHONY: all clean test run help

all: $(TARGET)

# Линковка
$(TARGET): $(OBJ)
	$(CC) $(CFLAGS) -o $@ $^

# Компиляция (с автоматической генерацией зависимостей)
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# ------------------------------------------------------------
#  Тестирование
# ------------------------------------------------------------
test: $(TARGET)
	@chmod +x test_filecopy.sh
	@./test_filecopy.sh

# ------------------------------------------------------------
#  Запуск вручную
#  Пример: make run ARGS="fileA.txt fileB.txt"
#          make run ARGS="-p myfifo fileC.bin"
# ------------------------------------------------------------
run: $(TARGET)
	@./$(TARGET) $(ARGS)

# ------------------------------------------------------------
#  Очистка
# ------------------------------------------------------------
clean:
	rm -f $(OBJ) $(TARGET)

distclean: clean
	rm -rf test_env *.copy myfifo_data myfifo_sync

# ------------------------------------------------------------
#  Справка
# ------------------------------------------------------------
help:
	@echo "Доступные цели:"
	@echo "  make            — собрать программу $(TARGET)"
	@echo "  make test       — запустить скрипт тестирования"
	@echo "  make run ARGS=... — запустить программу с аргументами"
	@echo "  make clean      — удалить объектные файлы и бинарник"
	@echo "  make distclean  — полная очистка (включая результаты тестов)"
	@echo "  make help       — эта справка"

